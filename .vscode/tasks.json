{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GremoVOD: Inspect GitHub PR (no models)",
      "type": "process",
      "command": "${input:relayPython}",
      "args": ["${workspaceFolder}/scripts/agent-handoff/dispatcher.py", "--pr", "${input:relayPr}"],
      "problemMatcher": []
    },
    {
      "label": "GremoVOD: Plan bounded relay job (no models)",
      "type": "process",
      "command": "${input:relayPython}",
      "args": ["${workspaceFolder}/scripts/agent-handoff/dispatcher.py", "--job", "${input:relayJob}", "--state-dir", "${input:relayState}"],
      "problemMatcher": []
    },
    {
      "label": "GremoVOD: Advance already approved relay job",
      "type": "process",
      "command": "${input:relayPython}",
      "args": ["${workspaceFolder}/scripts/agent-handoff/dispatcher.py", "--job", "${input:relayJob}", "--run", "--state-dir", "${input:relayState}"],
      "problemMatcher": []
    },
    {
      "label": "GremoVOD: Publish owner-attested local review JSON",
      "type": "process",
      "command": "${input:relayPython}",
      "args": ["${workspaceFolder}/scripts/agent-handoff/dispatcher.py", "--job", "${input:relayJob}", "--publish-review", "${input:relayReview}", "--attest-local", "--state-dir", "${input:relayState}"],
      "problemMatcher": []
    },
    {
      "label": "GremoVOD: STOP relay",
      "type": "process",
      "command": "${input:relayPython}",
      "args": ["${workspaceFolder}/scripts/agent-handoff/dispatcher.py", "--stop", "--state-dir", "${input:relayState}"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {"id": "relayPython", "type": "promptString", "description": "Absolute Python interpreter, identical to job tests argv[0]", "default": "C:/AI_Workflow_Studio/.venv/Scripts/python.exe"},
    {"id": "relayPr", "type": "promptString", "description": "Numeric GitHub PR number (read-only)", "default": "58"},
    {"id": "relayJob", "type": "promptString", "description": "Absolute path to owner-reviewed relay job.json"},
    {"id": "relayState", "type": "promptString", "description": "Persistent state directory outside both model worktrees"},
    {"id": "relayReview", "type": "promptString", "description": "Structured JSON from local Codex; publication explicitly attests its provenance"}
  ]
}
