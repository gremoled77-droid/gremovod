{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GremoVOD: Codex feedback → MiniMax (GitHub PR)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/agent-handoff/Get-CodexReview.ps1",
        "-PrNumber",
        "${input:gremovodGaPr}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "GremoVOD: Watch Codex → MiniMax (safe)",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/agent-handoff/dispatcher.py",
        "--pr",
        "${input:gremovodGaPr}",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "gremovodGaPr",
      "type": "promptString",
      "description": "Числовой номер GitHub Pull Request MiniMax (например, 1234; не GA-01)",
      "default": ""
    }
  ]
}
