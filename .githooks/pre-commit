#!/bin/sh
set -eu
repo=$(git rev-parse --show-toplevel)
common=$(git rev-parse --path-format=absolute --git-common-dir)
shared=${common%/*}
if [ -x "$repo/.venv/Scripts/python.exe" ]; then
  exec "$repo/.venv/Scripts/python.exe" -X utf8 "$repo/scripts/check_git_files.py" --staged
elif [ -x "$shared/.venv/Scripts/python.exe" ]; then
  exec "$shared/.venv/Scripts/python.exe" -X utf8 "$repo/scripts/check_git_files.py" --staged
else
  exec python "$repo/scripts/check_git_files.py" --staged
fi
