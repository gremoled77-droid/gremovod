{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gremoled77-droid/gremovod/blob/feature/n8n-astra-contract-hardening-20261019/docs/specs/n8n-production-2026-10-19/contracts/runtime-v1.schema.json",
  "title": "GremoVOD n8n Astra runtime v1 — structure only; checksums/signatures require trusted backend",
  "description": "Roles, budget and evidence are NOT considered trusted merely because this JSON validates. Owner and backend evidence verification are separate mandatory gates.",
  "$defs": {
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "source_revision",
        "input_snapshot_hash",
        "state_revision"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "input_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0
        },
        "lease_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "BudgetGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "project_id",
        "run_id",
        "cap_cents",
        "max_calls",
        "expires_at",
        "owner_decision_id"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cap_cents": {
          "type": "integer",
          "minimum": 1
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner_decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "model_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "stage_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "RequestAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "operation_id",
        "stage",
        "provider",
        "model",
        "profile_revision",
        "frozen_request_hash",
        "artifact_revision",
        "upper_cents",
        "grant_id"
      ],
      "properties": {
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_revision": {
          "type": "string",
          "minLength": 1
        },
        "frozen_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_revision": {
          "type": "string",
          "minLength": 1
        },
        "upper_cents": {
          "type": "integer",
          "minimum": 1
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ProviderJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "request_hash",
        "provider",
        "status",
        "possible_charge",
        "reserved_cents"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "PREPARED",
            "AUTHORIZED",
            "SUBMITTING",
            "UNKNOWN",
            "SUBMITTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED"
          ]
        },
        "provider_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "possible_charge": {
          "type": "boolean"
        },
        "reserved_cents": {
          "type": "integer",
          "minimum": 0
        },
        "actual_cost_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ExpectedSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "kind",
        "required",
        "revision",
        "status"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "shot",
            "dialogue",
            "music",
            "sfx",
            "ambience",
            "title",
            "source_reference",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_take_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "MISSING",
            "CANDIDATE",
            "FULFILLED",
            "SKIPPED",
            "BLOCKED"
          ]
        }
      }
    },
    "Derivative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "source_checksum",
        "derivative_checksum",
        "transform_name",
        "transform_version",
        "transform_parameters_hash",
        "media_type",
        "time_coverage",
        "streams"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "derivative_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transform_name": {
          "type": "string",
          "minLength": 1
        },
        "transform_version": {
          "type": "string",
          "minLength": 1
        },
        "transform_parameters_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "enum": [
            "image",
            "audio",
            "video"
          ]
        },
        "time_coverage": {
          "type": "object",
          "required": [
            "start_ms",
            "end_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "codec"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "video",
                  "audio",
                  "subtitle"
                ]
              },
              "codec": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "viewer_access_verified": {
          "type": "boolean"
        }
      }
    },
    "ReviewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_round_id",
        "snapshot_hash",
        "master_checksum",
        "manifest_hash",
        "requirements_hash",
        "canon_hash",
        "bar_hash",
        "policy_hash",
        "profiles_hash",
        "skills_hash"
      ],
      "properties": {
        "review_round_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "master_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requirements_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canon_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bar_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profiles_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "skills_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "CriticVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_round_id",
        "role",
        "snapshot_hash",
        "master_checksum",
        "verdict",
        "source_scope",
        "evidence"
      ],
      "properties": {
        "review_round_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "enum": [
            "A6",
            "A7",
            "A8"
          ]
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "master_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "source_scope": {
          "type": "array",
          "items": {
            "enum": [
              "TEXT",
              "IMAGE",
              "AUDIO",
              "VIDEO",
              "MOTION",
              "EDIT"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_checksum",
              "start_ms",
              "end_ms",
              "kind"
            ],
            "properties": {
              "source_checksum": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "text_quote",
                  "frame",
                  "video_window",
                  "audio_window",
                  "transcript"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "OwnerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "project_id",
        "run_id",
        "review_round_id",
        "snapshot_hash",
        "master_checksum",
        "decision",
        "owner_identity",
        "object_revision"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "review_round_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "master_checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "APPROVE_BUDGET",
            "AUTHORIZE_REQUEST",
            "APPROVE_REFERENCE",
            "SELECT_CONCEPT",
            "SELECT_TAKE",
            "READY",
            "RETURN_FOR_FIX"
          ]
        },
        "owner_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "object_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/BudgetGrant"
    },
    {
      "$ref": "#/$defs/RequestAuthorization"
    },
    {
      "$ref": "#/$defs/ProviderJob"
    },
    {
      "$ref": "#/$defs/ExpectedSlot"
    },
    {
      "$ref": "#/$defs/Derivative"
    },
    {
      "$ref": "#/$defs/ReviewSnapshot"
    },
    {
      "$ref": "#/$defs/CriticVerdict"
    },
    {
      "$ref": "#/$defs/OwnerDecision"
    }
  ]
}
