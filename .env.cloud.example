# Скопируй в .env.cloud и заполни. Файл .env.cloud нельзя коммитить.
STUDIO_DOMAIN=studio.example.com
STUDIO_REMOTE_HOSTS=studio.example.com
# Не короче 12 символов; лучше длинная фраза
STUDIO_ACCESS_PASSWORD=
PIAPI_API_KEY=
# Необязательно:
# ELEVENLABS_API_KEY=
# FISH_AUDIO_API_KEY=
# Доверенные proxy для заголовка X-Forwarded-For: IP или CIDR через запятую.
# Пусто (по умолчанию) — forwarded-заголовки не доверяем, лимит попыток входа считается
# по адресу прямого соединения. Укажи адрес именно своего обратного proxy.
# STUDIO_TRUSTED_PROXIES=
# Сколько ходов proxy между клиентом и студией (по умолчанию — по числу адресов выше).
# STUDIO_TRUSTED_PROXY_HOPS=1
